{
  "name": "khobra-cleaning-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npx tsc -p apps/web/tsconfig.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.25",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.3"
  }
}
