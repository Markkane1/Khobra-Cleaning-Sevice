{
  "expo": {
    "name": "Khobra Cleaning",
    "slug": "khobra-cleaning",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "package": "com.khobracleaning.app",
      "adaptiveIcon": { "foregroundImage": "./assets/icon.png", "backgroundColor": "#F1FBF8" }
    },
    "ios": {
      "bundleIdentifier": "com.khobracleaning.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "@preeternal/react-native-cookie-manager",
        { "androidWebkitVersion": "1.16.0" }
      ]
    ],
    "splash": { "image": "./assets/logo.png", "resizeMode": "contain", "backgroundColor": "#F1FBF8" }
  }
}
