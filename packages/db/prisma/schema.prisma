generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ TENANT / ORGANIZATION ============

model Tenant {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  currency         String   @default("AED")
  locale           String   @default("en-AE")
  timezone         String   @default("Asia/Dubai")
  taxRate          Decimal  @default(0.0) @db.Decimal(7, 6)
  firstBookingTime String   @default("08:00")
  lastWorkingTime  String   @default("20:00")
  logoUrl          String?
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users                     User[]
  branches                  Branch[]
  services                  Service[]
  customers                 Customer[]
  employees                 Employee[]
  drivers                   Driver[]
  bookings                  Booking[]
  invoices                  Invoice[]
  inventoryItems            InventoryItem[]
  vendors                   Vendor[]
  complaints                Complaint[]
  attendances               Attendance[]
  leaveRecords              LeaveRecord[]
  assignments               Assignment[]
  trips                     Trip[]
  payments                  Payment[]
  stockMovements            StockMovement[]
  payrollRecords            PayrollRecord[]
  completionTimingResponses BookingCompletionTimingResponse[]
  bookingRatings            BookingRating[]
  notifications             Notification[]
  driverExpenses            DriverExpense[]
  businessExpenses          BusinessExpense[]
  companyBankAccounts       CompanyBankAccount[]
  transactionSnapshots      TransactionSnapshot[]
  uploadAssets              UploadAsset[]
  paymentEvents             PaymentEvent[]
  pushSubscriptions         PushSubscription[]
}

model UploadAsset {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  url       String   @unique
  publicId  String   @unique
  purpose   String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId, purpose])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

model ReferenceSequence {
  tenantId String
  kind     String
  value    Int

  @@id([tenantId, kind])
}

model CompanyBankAccount {
  id            String   @id @default(cuid())
  tenantId      String
  bankName      String
  accountTitle  String
  accountNumber String
  iban          String?
  branchName    String?
  branchCode    String?
  currency      String   @default("AED")
  instructions String?
  displayOrder Int      @default(0)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  isDeleted     Boolean  @default(false)
  createdBy     String
  updatedBy     String
  activatedBy   String?
  deactivatedBy String?
  deletedBy     String?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  creator     User   @relation("BankAccountCreator", fields: [createdBy], references: [id])
  updater     User   @relation("BankAccountUpdater", fields: [updatedBy], references: [id])
  activator   User?  @relation("BankAccountActivator", fields: [activatedBy], references: [id], onDelete: SetNull)
  deactivator User?  @relation("BankAccountDeactivator", fields: [deactivatedBy], references: [id], onDelete: SetNull)
  deleter     User?  @relation("BankAccountDeleter", fields: [deletedBy], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([tenantId, isActive])
}

model TransactionSnapshot {
  id            String   @id @default(cuid())
  tenantId      String
  paymentId     String   @unique
  bookingNo     String
  customerName  String
  serviceName   String
  hourlyRate    Decimal  @db.Decimal(14, 2)
  duration      Float
  employeeCount Int
  subtotal      Decimal  @db.Decimal(14, 2)
  taxAmount     Decimal  @db.Decimal(14, 2)
  discount      Decimal  @db.Decimal(14, 2)
  totalAmount   Decimal  @db.Decimal(14, 2)
  snapshotData  Json
  createdAt     DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}


model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ============ IDENTITY & ACCESS ============

model User {
  id           String    @id @default(cuid())
  tenantId     String?
  email        String    @unique
  passwordHash String?
  phone        String?
  name         String
  avatarUrl    String?
  role         String    @default("customer")
  status       String    @default("active")
  sessionVersion Int     @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  employee Employee?
  driver   Driver?
  customer Customer?
  bookingStatusChanges BookingStatusHistory[] @relation("BookingStatusActor")
  pushSubscriptions   PushSubscription[]
  bankAccountsCreated CompanyBankAccount[] @relation("BankAccountCreator")
  bankAccountsUpdated CompanyBankAccount[] @relation("BankAccountUpdater")
  bankAccountsActivated CompanyBankAccount[] @relation("BankAccountActivator")
  bankAccountsDeactivated CompanyBankAccount[] @relation("BankAccountDeactivator")
  bankAccountsDeleted CompanyBankAccount[] @relation("BankAccountDeleter")
  leaveApprovals LeaveRecord[] @relation("LeaveApprover")
  bookingsCreated Booking[] @relation("BookingCreator")
  bookingsCancelled Booking[] @relation("BookingCanceller")
  pickupAlertsGenerated BookingPickupAlert[] @relation("PickupAlertGenerator")
  driverExpensesSubmitted DriverExpense[] @relation("DriverExpenseSubmitter")
  driverExpensesApproved DriverExpense[] @relation("DriverExpenseApprover")
  businessExpensesCreated BusinessExpense[] @relation("BusinessExpenseCreator")
  paymentsReceived Payment[] @relation("PaymentReceiver")
  paymentMethodsSelected Payment[] @relation("PaymentSelector")
  paymentsVerified Payment[] @relation("PaymentVerifier")
  paymentEvents PaymentEvent[] @relation("PaymentEventActor")
  complaintsAssigned Complaint[] @relation("ComplaintAssignee")
}

// ============ SERVICE CATALOG ============

model Service {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  baseRate          Decimal  @db.Decimal(14, 2)
  minDuration       Int      @default(2)
  category          String?
  status            String   @default("active")
  requiresMaterials Boolean  @default(false)
  skills            String?
  galleryImages     Json?
  heroImages        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  bookings     Booking[]
  bookingItems BookingItem[]
}

// ============ CRM - CUSTOMErs ============

model Customer {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String   @unique
  phone       String?
  altPhone    String?
  address     String?
  addresses   Json?
  city        String?
  area        String?
  notes       String?
  preferences String?
  status      String    @default("active")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  bookings   Booking[]
  invoices   Invoice[]
  complaints Complaint[]
  ratings    BookingRating[]
}

// ============ WORKFORCE - EMPLOYEES ============

model Employee {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String    @unique
  employeeCode String    @unique
  phone        String?
  address      String?
  city         String?
  area         String?
  skills       String?
  baseSalary   Decimal   @default(0) @db.Decimal(14, 2)
  status       String    @default("active")
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                           Tenant                            @relation(fields: [tenantId], references: [id])
  user                             User                              @relation(fields: [userId], references: [id])
  assignments                      Assignment[]
  attendances                      Attendance[]
  leaveRecords                     LeaveRecord[]
  payrollRecords                   PayrollRecord[]
  bookingCompletionTimingResponses BookingCompletionTimingResponse[]
}

model Attendance {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  date       DateTime
  clockIn    DateTime?
  clockOut   DateTime?
  status     String    @default("present")
  notes      String?
  createdAt  DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, date])
}

model LeaveRecord {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime
  days       Float
  status     String   @default("pending")
  reason     String?
  approvedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  approver User? @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
}

// ============ DRIVErs ============

model Driver {
  id          String    @id @default(cuid())
  tenantId    String
  userId      String    @unique
  driverCode  String    @unique
  phone       String?
  vehicleInfo String?
  licenseNo   String?
  status      String    @default("active")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt


  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  trips        Trip[]
  bookings     Booking[]
  pickupAlerts BookingPickupAlert[]
  expenses     DriverExpense[]
}

// ============ BOOKINGS ============

model Booking {
  id                 String   @id @default(cuid())
  tenantId           String
  bookingNo          String   @unique
  customerId         String
  driverId           String?
  serviceId          String?
  status             String   @default("pending")
  scheduledDate      DateTime @db.Date
  startTime          String
  endTime            String?
  duration           Float
  employeeCount      Int      @default(1)
  materialsCost      Decimal  @default(0) @db.Decimal(14, 2)
  hourlyRate         Decimal  @db.Decimal(14, 2)
  totalAmount        Decimal  @db.Decimal(14, 2)
  discount           Decimal  @default(0) @db.Decimal(14, 2)
  netAmount          Decimal  @db.Decimal(14, 2)
  address            String?
  city               String?
  area               String?
  notes              String?
  isRecurring        Boolean  @default(false)
  recurringRule      String?
  recurringGroupId   String?
  cancellationReason String?
  cancelledBy        String?
  noShowReason       String?
  noShowParty        String?
  createdBy              String?
  preferredPaymentMethod String?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  tenant                    Tenant                            @relation(fields: [tenantId], references: [id])
  customer                  Customer                          @relation(fields: [customerId], references: [id])
  driver                    Driver?                           @relation(fields: [driverId], references: [id], onDelete: SetNull)
  creator                   User?                             @relation("BookingCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  canceller                 User?                             @relation("BookingCanceller", fields: [cancelledBy], references: [id], onDelete: SetNull)
  service                   Service?                          @relation(fields: [serviceId], references: [id])
  items                     BookingItem[]
  materials                 BookingMaterial[]
  assignments               Assignment[]
  invoices                  Invoice[]
  complaints                Complaint[]
  statusHistory             BookingStatusHistory[]
  completionTimingResponses BookingCompletionTimingResponse[]
  pickupAlerts              BookingPickupAlert[]
  rating                    BookingRating?

  @@index([driverId])
}

model BookingStatusHistory {
  id             String   @id @default(cuid())
  bookingId      String
  previousStatus String
  newStatus      String
  changedBy      String?  @default("system")
  changedByUserId String?
  changedByRole   String   @default("system")
  reason         String?
  createdAt      DateTime @default(now())

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedByUser User?          @relation("BookingStatusActor", fields: [changedByUserId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([changedByUserId])
}

model BookingRating {
  id            String   @id @default(cuid())
  tenantId      String
  bookingId     String   @unique
  customerId    String
  overallRating Int
  comment       String?
  submittedAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, submittedAt])
  @@index([customerId])
}

model BookingCompletionTimingResponse {
  id                  String   @id @default(cuid())
  bookingId           String
  employeeId          String
  withinScheduledTime Boolean
  createdAt           DateTime @default(now())

  booking     Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee    Employee            @relation(fields: [employeeId], references: [id])
  pickupAlert BookingPickupAlert?
  tenant      Tenant?             @relation(fields: [tenantId], references: [id])
  tenantId    String?

  @@index([bookingId, createdAt])
}

model BookingPickupAlert {
  id                   String    @id @default(cuid())
  bookingId            String
  driverId             String
  timingResponseId     String?   @unique
  reason               String
  priority             String    @default("high")
  customerLocation     String
  scheduledEndTime     String?
  assignedCleanerNames String
  generatedBy          String
  generatedAt          DateTime  @default(now())
  viewedAt             DateTime?

  booking        Booking                          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver         Driver                           @relation(fields: [driverId], references: [id])
  generator      User                             @relation("PickupAlertGenerator", fields: [generatedBy], references: [id])
  timingResponse BookingCompletionTimingResponse? @relation(fields: [timingResponseId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([driverId, viewedAt, generatedAt])
}

model BookingItem {
  id            String   @id @default(cuid())
  bookingId     String
  serviceId     String
  hourlyRate    Decimal @db.Decimal(14, 2)
  employeeCount Int      @default(1)
  hours         Float
  totalAmount   Decimal @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
}

model BookingMaterial {
  id              String   @id @default(cuid())
  bookingId       String
  inventoryItemId String?
  name            String
  unit            String   @default("pcs")
  quantity        Float    @default(1)
  unitPrice       Decimal  @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)
  createdAt       DateTime @default(now())

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

// ============ ASSIGNMENTS & JOBS ============

model Assignment {
  id             String    @id @default(cuid())
  tenantId       String
  bookingId      String
  employeeId     String
  status         String    @default("assigned")
  startedAt      DateTime?
  completedAt    DateTime?
  actualHours    Float?
  overtimeHours  Float?
  notes          String?
  customerRating Float?
  ratingNotes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  booking  Booking  @relation(fields: [bookingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([bookingId, employeeId])
}

// ============ DISPATCH / TRIPS ============

model Trip {
  id           String   @id @default(cuid())
  tenantId     String
  driverId     String
  date         DateTime
  status       String   @default("planned")
  startMileage Float?
  endMileage   Float?
  fuelCost     Float?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  driver   Driver          @relation(fields: [driverId], references: [id])
  stops    TripStop[]
  expenses DriverExpense[]
}

model TripStop {
  id           String    @id @default(cuid())
  tripId       String
  type         String
  address      String?
  contactPhone String?
  status       String    @default("pending")
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  trip Trip @relation(fields: [tripId], references: [id])
}

model DriverExpense {
  id              String    @id @default(cuid())
  tenantId        String
  driverId        String
  tripId          String?
  category        String
  typeDetail      String?
  amount          Decimal   @db.Decimal(14, 2)
  currency        String    @default("AED")
  expenseDate     DateTime
  notes           String?
  receiptUrl      String?
  status          String    @default("pending")
  submittedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  decisionRemarks String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])
  trip   Trip?  @relation(fields: [tripId], references: [id], onDelete: SetNull)
  submitter User @relation("DriverExpenseSubmitter", fields: [submittedBy], references: [id])
  approver User? @relation("DriverExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([tenantId, expenseDate])
  @@index([driverId, status])
}

model BusinessExpense {
  id          String   @id @default(cuid())
  tenantId    String
  category    String
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("AED")
  expenseDate DateTime
  notes       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  creator User @relation("BusinessExpenseCreator", fields: [createdBy], references: [id])

  @@index([tenantId, expenseDate])
  @@index([tenantId, category])
}

// ============ FINANCE ============

model Invoice {
  id                    String    @id @default(cuid())
  tenantId              String
  invoiceNo             String    @unique
  bookingId             String?   @unique
  customerId            String
  status                String    @default("draft")
  issuedAt              DateTime?
  dueDate               DateTime?
  subtotal              Decimal   @db.Decimal(14, 2)
  taxAmount             Decimal   @default(0) @db.Decimal(14, 2)
  discount              Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount           Decimal   @db.Decimal(14, 2)
  paidAmount            Decimal   @default(0) @db.Decimal(14, 2)
  selectedPaymentMethod String?
  paymentSelectedBy     String?
  paymentSelectedAt     DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  payments Payment[]
}

model Payment {
  id                         String    @id @default(cuid())
  tenantId                   String
  invoiceId                  String
  amount                     Decimal   @db.Decimal(14, 2)
  transactionNo              String?   @unique
  method                     String
  referenceNo                String?
  proofUrl                   String?
  status                     String    @default("pending")
  reconciliationStatus       String    @default("not_required")
  receivedBy                 String?
  receivedAt                 DateTime?
  selectedBy                 String?
  customerBankName           String?
  accountHolderName          String?
  companyBankAccountId       String?
  companyBankAccountSnapshot String?
  transferDate               DateTime?
  submittedAt                DateTime?
  verifiedBy                 String?
  verifiedAt                 DateTime?
  rejectedAt                 DateTime?
  decisionRemarks            String?
  notes                      String?
  legacyImportedAt           DateTime?
  legacyReason               String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  invoice             Invoice              @relation(fields: [invoiceId], references: [id])
  companyBankAccount  CompanyBankAccount?  @relation(fields: [companyBankAccountId], references: [id])
  receiver            User?                @relation("PaymentReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)
  selector            User?                @relation("PaymentSelector", fields: [selectedBy], references: [id], onDelete: SetNull)
  verifier            User?                @relation("PaymentVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  transactionSnapshot TransactionSnapshot?
  events              PaymentEvent[]

  @@unique([tenantId, referenceNo])
  @@index([companyBankAccountId])
}

model PaymentEvent {
  id         String   @id @default(cuid())
  tenantId   String
  paymentId  String
  event      String
  status     String
  actorId    String?
  remarks    String?
  metadata   Json?
  occurredAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?   @relation("PaymentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, paymentId, occurredAt])
}


// ============ INVENTORY ============

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  sku          String?
  category     String?
  unit         String   @default("pcs")
  currentStock Float    @default(0)
  minStock     Float    @default(0)
  costPrice    Decimal  @default(0) @db.Decimal(14, 2)
  sellPrice    Decimal  @default(0) @db.Decimal(14, 2)
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  movements        StockMovement[]
  vendorItems      VendorItem[]
  bookingMaterials BookingMaterial[]
}

model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  items  VendorItem[]
}

model VendorItem {
  id           String   @id @default(cuid())
  vendorId     String
  itemId       String
  unitPrice    Decimal  @db.Decimal(14, 2)
  leadTimeDays Int      @default(0)
  createdAt    DateTime @default(now())

  vendor Vendor        @relation(fields: [vendorId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])
}

model StockMovement {
  id        String   @id @default(cuid())
  tenantId  String
  itemId    String
  type      String
  quantity  Float
  unitCost  Decimal? @db.Decimal(14, 2)
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  item   InventoryItem @relation(fields: [itemId], references: [id])
}

// ============ COMPLAINTS ============

model Complaint {
  id          String    @id @default(cuid())
  tenantId    String
  complaintNo String    @unique
  customerId  String?
  bookingId   String?
  category    String?
  priority    String    @default("medium")
  status      String    @default("open")
  description String
  resolution  String?
  attachments String?
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  booking  Booking?  @relation(fields: [bookingId], references: [id])
  assignee User?     @relation("ComplaintAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
}

// ============ CONFIGURATION ============

model AppSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ============ PAYROLL & NOTIFICATIONS ============

model PayrollRecord {
  id         String    @id @default(cuid())
  tenantId   String
  employeeId String
  month      String
  year       Int
  baseSalary Decimal   @db.Decimal(14, 2)
  allowances Decimal   @default(0) @db.Decimal(14, 2)
  deductions Decimal   @default(0) @db.Decimal(14, 2)
  netSalary  Decimal   @db.Decimal(14, 2)
  status     String    @default("pending") // pending, approved, paid
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, employeeId, month, year])
}

model Notification {
  id                  String    @id @default(cuid())
  tenantId            String
  userId              String?
  statusHistoryId     String?
  pickupAlertId       String?
  title               String
  message             String
  type                String    @default("info") // info, success, warning, error
  channel             String    @default("in_app")
  deliveryStatus      String    @default("sent")
  deliveryAttemptedAt DateTime?
  deliveryError       String?
  read                Boolean   @default(false)
  createdAt           DateTime  @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  statusHistory BookingStatusHistory? @relation(fields: [statusHistoryId], references: [id], onDelete: Cascade)
  pickupAlert   BookingPickupAlert?   @relation(fields: [pickupAlertId], references: [id], onDelete: Cascade)

  @@unique([statusHistoryId, userId, channel])
  @@unique([pickupAlertId, userId, channel])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, active])
}
